<!doctype html>
<html lang="ja">
  <head>
    <!-- prettier-ignore -->
    <%_
      const localmeta = {
        title: `🍣3/20（Wed.)HIROSHIMA PARCO 30th ANNIVERSARY PARTY ~ Dig up fun ~ 出演決定🍣 | SUSHIBOYS`,
        description: `HIROSHIMA PARCO 30th ANNIVERSARY PARTY ~ Dig up fun ~ 出演決定🍣 3/20（水）HIROSHIMA CLUB QUATTROにて開催🍣`,
        url: 'https://sushiboys350.com/news/post058/',
        pageid: 'news',
        index: 58 - 1,
        path: '../../../'
      };
      const localogp = {
        title: localmeta.title,
        description: localmeta.description,
        url: localmeta.url
      };
      const localfile = {
        css: `/assets/css/news-detail.css`,
        js: `/assets/js/newsDetail.js`
      };
    _%>
    <%- include(localmeta.path + `_components/Head`, {meta: localmeta, ogp: localogp, file: localfile}); _%>
    <%- include(localmeta.path + `_data/news`); _%>
    <%_ newsData = news(); _%>
  </head>
  <body>
    <%- include(localmeta.path + `_components/GoogleTagManager`); _%>

    <div class="wrapper">
      <!-- prettier-ignore -->
      <%- include(localmeta.path + `_components/GlobalNavigation`, {meta: localmeta}); _%>

      <main class="main">
        <!-- prettier-ignore -->
        <%- include(localmeta.path + `_components/Header`, {meta: localmeta}); _%>

        <div>
          <!-- prettier-ignore -->
          <%- include(localmeta.path + `_components/Hero`, {meta: localmeta}); _%>

          <div class="content">
            <section class="section">
              <div class="section__inner">
                <%- include(localmeta.path + `_components/NewsArticle`, {meta:
                localmeta, newsData: newsData}); _%>
              </div>
            </section>
          </div>
        </div>

        <!-- prettier-ignore -->
        <%- include(localmeta.path + `_components/Toggle`); _%>

        <%- include(localmeta.path + `_components/Footer`); _%>
      </main>
    </div>
  </body>
</html>
