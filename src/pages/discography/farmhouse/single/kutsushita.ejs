<!doctype html>
<html lang="ja">
  <head>
    <!-- prettier-ignore -->
    <%_
      const localmeta = {
        title: `靴下 | SUSHIBOYS`,
        description: `靴下`,
        url: `https://sushiboys350.com/discography/farmhouse/single/kutsushita.html`,
        pageid: `discography`,
        type: `farmhouseSingle`,
        index: 0,
        path: '../../../../'
      };
      const localogp = {
        title: localmeta.title,
        description: localmeta.description,
        url: localmeta.url
      };
      const localfile = {
        css: `/assets/css/discography-detail.css`,
        js: `/assets/js/discographyDetail.js`
      };
    _%>
    <%- include(localmeta.path + `_components/head`, {meta: localmeta, ogp: localogp, file: localfile}); _%>
    <%- include(localmeta.path + `_data/discography`); _%>
    <%_ discographyData = discography(); _%>
  </head>
  <body>
    <%- include(localmeta.path + `_components/googletagmanager`); _%>

    <div class="wrapper">
      <!-- prettier-ignore -->
      <%- include(localmeta.path + `_components/globalNavigation`, {meta: localmeta}); _%>

      <main class="main">
        <!-- prettier-ignore -->
        <%- include(localmeta.path + `_components/header`, {meta: localmeta}); _%>

        <div>
          <!-- prettier-ignore -->
          <%- include(localmeta.path + `_components/hero`, {meta: localmeta}); _%>

          <div class="content">
            <section class="section">
              <div class="section__inner">
                <%- include(localmeta.path + `_components/discographyArticle`,
                {meta: localmeta, discographyData: discographyData}); _%>
              </div>
            </section>
          </div>
        </div>

        <!-- prettier-ignore -->
        <%- include(localmeta.path + `_components/toggle`); _%>

        <%- include(localmeta.path + `_components/footer`); _%>
      </main>
    </div>
  </body>
</html>
