<!doctype html>
<html lang="ja">
  <head>
    <!-- prettier-ignore -->
    <%_
      const localmeta = {
        title: `GOODS | SUSHIBOYS`,
        description: `SUSHIBOYSのグッズ一覧。グッズ購入・商品詳細ページへご案内いたします。`,
        url: `https://sushiboys350.com/goods/`,
        pageid: `goods`,
        path: `../../`
      };

      const localogp = {
        title: localmeta.title,
        description: localmeta.description,
        url: localmeta.url
      };

      const localfile = {
        css: `/assets/css/goods.css`,
        js: `/assets/js/goods.js`
      };
    _%>

    <%- include(localmeta.path + `_components/Head`, {meta: localmeta, ogp: localogp, file: localfile}); _%>

    <%- include(localmeta.path + `_data/goods`); _%>

    <%_ goodsData = goods(); _%>
  </head>
  <body>
    <%- include(localmeta.path + `_components/GoogleTagManager`); _%>

    <div class="wrapper">
      <%- include(localmeta.path + `_components/GlobalNavigation`, {meta:
      localmeta}); _%>

      <main class="main">
        <!-- prettier-ignore -->
        <%- include(localmeta.path + `_components/Header`, {meta: localmeta}); _%>

        <div>
          <%- include(localmeta.path + `_components/Hero`, {meta: localmeta});
          _%>

          <div class="content">
            <%- include(localmeta.path + `_components/GoodsList`, {goodsData:
            goodsData}); _%>
          </div>
        </div>

        <!-- prettier-ignore -->
        <%- include(localmeta.path + `_components/Toggle`); _%>

        <%- include(localmeta.path + `_components/Footer`); _%>
      </main>
    </div>
  </body>
</html>
