<!doctype html>
<html lang="ja">
  <head>
    <!-- prettier-ignore -->
    <%_
      const localmeta = {
        title: `GOODS | SUSHIBOYS`,
        description: `SUSHIBOYSのグッズ一覧。グッズ購入・商品詳細ページへご案内いたします。`,
        url: `https://sushiboys350.com/goods/`,
        pageid: `goods`,
        path: `../../`
      };

      const localogp = {
        title: localmeta.title,
        description: localmeta.description,
        url: localmeta.url
      };

      const localfile = {
        css: `/assets/css/goods.css`,
        js: `/assets/js/goods.js`
      };
    _%>

    <%- include(localmeta.path + `_components/Head`, {meta: localmeta, ogp: localogp, file: localfile}); _%>

    <%- include(localmeta.path + `_data/goods`); _%>

    <%_ goodsData = goods(); _%>
  </head>
  <body>
    <%- include(localmeta.path + `_components/GoogleTagManager`); _%>

    <div class="wrapper">
      <%- include(localmeta.path + `_components/GlobalNavigation`, {meta:
      localmeta}); _%>

      <main class="main">
        <!-- prettier-ignore -->
        <%- include(localmeta.path + `_components/Header`, {meta: localmeta}); _%>

        <div>
          <%- include(localmeta.path + `_components/Hero`, {meta: localmeta});
          _%>

          <div class="content">
            <section class="section">
              <div class="section__inner">
                <h3 class="section__heading section__heading--en">
                  Knickknack
                </h3>

                <%- include(localmeta.path + '_components/GoodsList', { id:
                'swiper-knickknack', goodsData: goodsData.knickknacks }); _%>
              </div>
            </section>

            <section class="section">
              <div class="section__inner">
                <h3 class="section__heading section__heading--en">
                  Recording media
                </h3>

                <%- include(localmeta.path + '_components/GoodsList', { id:
                'swiper-recording-media', goodsData: goodsData.recordingMedias
                }); _%>
              </div>
            </section>

            <section class="section">
              <div class="section__inner">
                <h3 class="section__heading section__heading--en">Cap</h3>

                <%- include(localmeta.path + '_components/GoodsList', { id:
                'swiper-cap', goodsData: goodsData.caps }); _%>
              </div>
            </section>

            <section class="section">
              <div class="section__inner">
                <h3 class="section__heading section__heading--en">Hoodie</h3>

                <%- include(localmeta.path + '_components/GoodsList', { id:
                'swiper-hoodie', goodsData: goodsData.hoodies }); _%>
              </div>
            </section>

            <section class="section">
              <div class="section__inner">
                <h3 class="section__heading section__heading--en">Parker</h3>

                <%- include(localmeta.path + '_components/GoodsList', { id:
                'swiper-parker', goodsData: goodsData.parkers }); _%>
              </div>
            </section>

            <section class="section">
              <div class="section__inner">
                <h3 class="section__heading section__heading--en">
                  Long T-Shirt
                </h3>

                <%- include(localmeta.path + '_components/GoodsList', { id:
                'swiper-long-t-shirt', goodsData: goodsData.longTShirts }); _%>
              </div>
            </section>

            <section class="section">
              <div class="section__inner">
                <h3 class="section__heading section__heading--en">T-Shirt</h3>

                <%- include(localmeta.path + '_components/GoodsList', { id:
                'swiper-t-shirt', goodsData: goodsData.tShirts }); _%>
              </div>
            </section>

            <section class="section">
              <div class="section__inner">
                <h3 class="section__heading section__heading--en">Shorts</h3>

                <%- include(localmeta.path + '_components/GoodsList', { id:
                'swiper-shorts', goodsData: goodsData.aLotsOfShorts }); _%>
              </div>
            </section>
          </div>
        </div>

        <!-- prettier-ignore -->
        <%- include(localmeta.path + `_components/Toggle`); _%>

        <%- include(localmeta.path + `_components/Footer`); _%>
      </main>
    </div>
  </body>
</html>
