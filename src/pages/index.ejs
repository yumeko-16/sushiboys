<!doctype html>
<html lang="ja">
  <head>
    <!-- prettier-ignore -->
    <%_
      const localmeta = {
        title: `SUSHIBOYS`,
        description: `SUSHIBOYSオフィシャルウェブサイト。メンバーはFARMHOUSE、サンテナ、DJ兼カメラマン兼マネージャー兼運転手兼スーパーバイザーのneo yosikawa。寿司ボーイズのライブ、ディスコグラフィ、グッズなどの最新情報を掲載しています。`,
        url: `https://sushiboys350.com/`,
        pageid: `home`,
        path: `../`
      };

      const localogp = {
        title: localmeta.title,
        description: localmeta.description,
        url: localmeta.url
      };

      const localfile = {
        css: `/assets/css/home.css`,
        js: `/assets/js/home.js`
      };
    _%>
    <%- include(localmeta.path + `_components/Head`, {meta: localmeta, ogp: localogp, file: localfile}); _%>
  </head>
  <body>
    <%- include(localmeta.path + `_components/GoogleTagManager`); _%>

    <div class="wrapper">
      <!-- prettier-ignore -->
      <%- include(localmeta.path + `_components/GlobalNavigation`, {meta: localmeta}); _%>

      <main class="main">
        <!-- prettier-ignore -->
        <%- include(localmeta.path + `_components/Header`, {meta: localmeta}); _%>

        <div>
          <!-- prettier-ignore -->
          <%- include(localmeta.path + `_components/Hero`, {meta: localmeta}); _%>

          <div class="content">
            <section class="section">
              <div class="section__inner">
                <%- include(localmeta.path + '_components/Biography'); _%>
              </div>
            </section>
          </div>
        </div>

        <!-- prettier-ignore -->
        <%- include(localmeta.path + `_components/Toggle`); _%>

        <%- include(localmeta.path + `_components/Footer`); _%>
      </main>
    </div>
  </body>
</html>
