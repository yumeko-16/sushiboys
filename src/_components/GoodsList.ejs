<%_ if (goodsData.length > 0) { _%>
<div id="<%= id %>" class="carousel swiper">
  <ul class="carousel__list swiper-wrapper">
    <%_ goodsData.forEach((item) => { _%>
    <li class="carousel__card swiper-slide">
      <%_ if (item?.link) { _%>
      <a href="<%- item.link %>" target="_blank" rel="noopener noreferrer">
        <img
          class="carousel__image"
          src="<%- item?.eyecatch.url || '/assets/img/no-image.png' %>"
          alt="<%- item?.eyecatch.alt || 'No image' %>"
          width="<%- item?.eyecatch.width %>"
          height="<%- item?.eyecatch.height %>"
        />
      </a>
      <%_ } else { _%>
      <img
        class="carousel__image"
        src="<%- item?.eyecatch.url || '/assets/img/no-image.png' %>"
        alt="<%- item?.eyecatch.alt || 'No image' %>"
        width="<%- item?.eyecatch.width %>"
        height="<%- item?.eyecatch.height %>"
      />
      <%_ } _%>
    </li>
    <%_ }); _%>
  </ul>
</div>
<%_ } else { _%>
<p>商品がありません。</p>
<%_ } _%>
