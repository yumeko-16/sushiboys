<section class="section">
  <div class="section__inner">
    <h3 class="section__heading section__heading--en">EP</h3>

    <div id="swiper-ep" class="carousel swiper">
      <ul class="carousel__list swiper-wrapper">
        <%_ (discographyData?.eps || []).forEach((item) => { _%>
        <li class="carousel__card swiper-slide">
          <a href="/discography/ep/<%- item?.slug || '#' %>">
            <img
              class="carousel__image"
              src="<%- item?.eyecatch.url || '/assets/img/no-image.png' %>"
              alt="<%- item?.eyecatch.alt || 'No image' %>"
              width="<%- item?.eyecatch.width %>"
              height="<%- item?.eyecatch.height %>"
            />
          </a>
        </li>
        <%_ }); _%>
      </ul>
    </div>
  </div>
</section>

